# External API credentials — never commit real values.
# OpenAI covers voice (M7: Whisper STT + TTS).
OPENAI_API_KEY=
# OpenRouter covers the Jev gate (M4) and LLM answer generation (M5/M6).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Jev decision model (always via OpenRouter). Options:
#   typesafe/jev-1.14  - pinned, newest version (recommended for predictable latency)
#   typesafe/jev-1.13  - pinned, previous version
#   typesafe/jev-router - routes among Jev variants (and sometimes non-Jev models!)
JEV_MODEL=typesafe/jev-1.14

# LLM answer generator: pick the provider for M5
# LLM_PROVIDER=openai     → use OPENAI_API_KEY, model e.g. "gpt-4o-mini"
# LLM_PROVIDER=openrouter → use OPENROUTER_API_KEY, model e.g. "openai/gpt-4o-mini"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI transcription model. Options:
#   whisper-1                  - cheapest, OK for clear native English
#   gpt-4o-mini-transcribe     - recommended; much better accents + domain terms
#   gpt-4o-transcribe          - highest accuracy
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# ISO 639-1 code. Pin to "en" to stop auto-detection drifting
# (e.g. to Hindi for accented English or noisy audio). Blank = auto-detect.
STT_LANGUAGE=en
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Storage paths (relative to project root)
VECTOR_STORE_PATH=data/indexes
METADATA_DB_PATH=data/metadata/tutor.db
UPLOADS_PATH=data/uploads
EXTRACTED_PATH=data/extracted

# Retrieval
TOP_K=5
MAX_RETRIEVAL_ATTEMPTS=2

# Behavior toggles
ENABLE_ANSWER_VERIFICATION=false
DEBUG_MODE=false

# Logging
LOG_LEVEL=INFO
